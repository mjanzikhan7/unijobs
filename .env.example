# Development settings. Copy to .env and change what you need:
#
#   cp .env.example .env
#
# .env is ignored by git. Never commit it, and never put a real secret in this file.
# Every value here is also the default in compose.yaml, and is only safe on a developer
# machine, where every port is bound to 127.0.0.1.

DJANGO_SECRET_KEY=dev-only-not-a-real-secret-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173

POSTGRES_DB=hejobs
POSTGRES_USER=hejobs
POSTGRES_PASSWORD=hejobs
POSTGRES_PORT_HOST=5433
REDIS_PORT_HOST=6380

FRONTEND_BASE_URL=http://localhost:5173
# Read by the Vite dev server inside its container, so it must be the service name.
VITE_API_BASE_URL=http://backend:8000

# Sent in the crawler's User-Agent, so a site owner can reach you.
CRAWLER_CONTACT_EMAIL=you@example.com
CRAWLER_PLAYWRIGHT_ENABLED=1

DIGEST_ENABLED=0
DIGEST_TO_EMAIL=you@example.com

# Mailpit catches every email in development.
EMAIL_HOST=mailpit
EMAIL_PORT=1025

# Password of the e2e-candidate and e2e-admin accounts (make e2e).
E2E_PASSWORD=e2e-password
