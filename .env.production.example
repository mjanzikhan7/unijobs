# Production settings. Copy to .env.production and fill in every value:
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#   docker compose -f compose.production.yaml --env-file .env.production up -d --build
#
# .env.production is ignored by git. Never commit it.
#
# The "replace-me" values below only exist so that `make build-production` can build the
# images. The application refuses to start with them.
#
# Generate each secret separately:
#
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"

DJANGO_SECRET_KEY=replace-me
POSTGRES_PASSWORD=replace-me
REDIS_PASSWORD=replace-me

DJANGO_ALLOWED_HOSTS=jobs.example.ac.uk
DJANGO_CSRF_TRUSTED_ORIGINS=https://jobs.example.ac.uk
DJANGO_CORS_ALLOWED_ORIGINS=
FRONTEND_BASE_URL=https://jobs.example.ac.uk

POSTGRES_DB=hejobs
POSTGRES_USER=hejobs

CRAWLER_CONTACT_EMAIL=you@example.com

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=jobs@example.ac.uk

# Bearer token for /api/metrics/. Leave empty to turn the endpoint off.
METRICS_TOKEN=

GATEWAY_PORT=8080
LOG_LEVEL=INFO
